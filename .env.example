# RPC — paid recommended (Alchemy/QuickNode/dRPC) for low latency
RPC_URL=https://mainnet.base.org

# Multi-RPC failover (optional, comma-separated)
# RPC_URLS=https://primary,https://backup1,https://backup2

# Gas settings
GAS_MULTIPLIER=1.2          # 1.0 = match base fee, higher = aggressive
PRIORITY_GWEI=0.01          # tip, 0.01 cheap, 0.1 fast
MAX_GAS_GWEI=5              # cap for Base (very low usually)

# Mining settings
PARALLEL_WORKERS=5          # concurrent wallets mining
WORKER_THREADS=2            # CPU threads per wallet (each wallet = own challenge)
TARGET_MINTS_PER_WALLET=0   # 0 = unlimited, else stop at N successful
DRY_RUN=false               # simulate, no broadcast

# Optional: stop mining if difficulty too high (skip current epoch)
# Difficulty 2^224 = baseline. Adjust if needed.
SKIP_HARD_EPOCH=false
